{
  "name": "orbit",
  "private": true,
  "type": "module",
  "description": "Personal life dashboard — habits, job hunt, money runway, body, garden.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/logic.check.ts",
    "typecheck": "tsc",
    "build:app": "vite build --mode app",
    "preview:app": "vite preview --port 4400"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
